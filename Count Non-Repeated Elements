class Solution{
    public int countNonRepeated(int arr[]){
        
        int max=0;
        int count = 0;
        for(int i:arr)
        if(max<i)
        max=i;
        
        int[] a = new int [max+1];
        for(int i:arr)
        a[i]++;
        
        for(int i:a){    //(0,2,2,2,1,1,1,1)
            if(i==1)
            count++;
        
        
    }
        return count;
        
    }
}
